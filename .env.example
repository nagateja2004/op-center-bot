# Copy this file to .env and replace every placeholder secret.
GROQ_API_KEY=gsk_replace_with_your_key

# Docker application and state
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8501
POSTGRES_DB=opcenter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_long_random_password
CHECKPOINT_BACKEND=postgres
DATABASE_URL=postgresql://postgres:replace_with_a_long_random_password@postgres:5432/opcenter
REDIS_URL=redis://redis:6379/0
DEPLOYMENT_ENVIRONMENT=local
TOKENIZERS_PARALLELISM=false

# Supported Groq role models
GROQ_PLANNER_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_QUERY_BROADENING_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_QUERY_BROADENING_FALLBACK_MODEL=
GROQ_GRADER_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_GRADER_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_ANSWER_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_ANSWER_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_VERIFIER_PRIMARY_MODEL=qwen/qwen3.6-27b
GROQ_VERIFIER_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_DIAGRAM_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_DIAGRAM_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# Provider and local inference limits
GROQ_MODEL_MAX_CONCURRENCY=4
GROQ_MODEL_REQUESTS_PER_MINUTE=30
GROQ_MODEL_TOKENS_PER_MINUTE=60000
GROQ_MAX_QUEUE_DEPTH=20
GROQ_MAX_QUEUE_WAIT_SECONDS=30
GROQ_REQUEST_STATUS_TTL_SECONDS=900
GROQ_REQUEST_TIMEOUT=90
INFERENCE_MAX_CONCURRENCY=4
INFERENCE_MAX_QUEUE_DEPTH=32

# Retrieval models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_MODE=server
CHROMA_COLLECTION=opcenter_manuals

# Selective OCR ingestion
DOCUMENT_PARSER=pymupdf
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_NATIVE_CHARS=40
PADDLE_OCR_ENABLED=true
PADDLE_OCR_DEVICE=cpu

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opcenter-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional semantic evaluation. Set a long random token before enabling it.
EVALUATION_API_TOKEN=
